# Keep AUTH_ENABLED=0 until the tenant, API scope and storage are ready.
AUTH_ENABLED=0
# Set AUTH_MODE=local with PostgreSQL for temporary site accounts.
# AUTH_MODE=entra keeps the Microsoft Entra flow after its tenant is ready.
AUTH_MODE=off
PROGRESS_BACKEND=tables
DATABASE_URL=
CSN_POSTGRES_PASSWORD=
CSN_COOKIE_SECURE=1
# Docker Compose listens on localhost by default. Open this only on a trusted LAN.
CSN_BIND_ADDRESS=127.0.0.1
ENTRA_TENANT_ID=
ENTRA_TENANT_SUBDOMAIN=
ENTRA_API_AUDIENCE=
ENTRA_SPA_CLIENT_ID=
ENTRA_API_SCOPE=
ENTRA_REQUIRED_SCOPE=access_as_user
AUTH_DEFAULT_USER_ROLE=1
# Choose a connection string OR managed identity account URL.
AZURE_TABLES_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_URL=
